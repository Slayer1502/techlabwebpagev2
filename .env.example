# Required: Set a strong random secret for JWT token signing
JWT_SECRET=change-this-to-a-random-string

# Optional: Override default passwords for seeded users
# DEFAULT_ADMIN_PASSWORD=admin123
# DEFAULT_EMPLOYEE_PASSWORD=service123
# DEFAULT_SALES_PASSWORD=sales123
# DEFAULT_TECHNICIAN_PASSWORD=tech123

# Optional: Server host (default: 0.0.0.0)
# HOST=0.0.0.0

# Optional: Server port (default: 3000)
# PORT=3000

# Set to "production" to enable production mode (stricter security)
# NODE_ENV=production
